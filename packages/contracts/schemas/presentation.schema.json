{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "presentation.schema.json", "title": "PresentationDocument",
  "type": "object", "additionalProperties": false, "required": ["stage", "slides"],
  "properties": {
    "stage": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 1920 }, "height": { "const": 1080 } } },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Slide" } }
  },
  "definitions": {
    "MediaIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "fidelity", "slotId", "targetAspectRatio", "cropPolicy", "subjectSafeArea", "language", "brandTokens", "provenance", "rights", "alt"],
      "properties": {
        "role": { "enum": ["evidence", "illustration", "decoration"] }, "fidelity": { "enum": ["source", "illustrative", "photographic"] },
        "slotId": { "type": "string", "minLength": 1 }, "targetAspectRatio": { "enum": ["16:9", "4:3", "1:1", "3:4", "9:16"] },
        "cropPolicy": { "enum": ["contain", "cover", "none"] }, "subjectSafeArea": { "$ref": "common.schema.json#/definitions/Insets" },
        "language": { "type": "string", "minLength": 1 }, "brandTokens": { "$ref": "common.schema.json#/definitions/Tokens" },
        "provenance": { "$ref": "common.schema.json#/definitions/SourceRef" },
        "rights": { "type": "object", "additionalProperties": false, "required": ["status", "license"], "properties": { "status": { "enum": ["user-provided", "licensed", "public-domain"] }, "license": { "type": "string", "minLength": 1 } } },
        "alt": { "type": "string", "minLength": 1 }, "caption": { "type": "string" }
      }
    },
    "SlotAssignment": { "type": "object", "additionalProperties": false, "required": ["id", "order", "slotId", "blockIds", "assetIds"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "slotId": { "type": "string", "minLength": 1 }, "blockIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/definitions/StableId" } }, "assetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/definitions/StableId" } } } },
    "SpeakerNotes": { "type": "object", "additionalProperties": false, "required": ["id", "slideId", "talk", "transition", "interaction", "stageDirections"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "slideId": { "$ref": "common.schema.json#/definitions/StableId" }, "talk": { "type": "string" }, "transition": { "type": "string" }, "interaction": { "type": "string" }, "stageDirections": { "type": "string" } } },
    "Timing": { "type": "object", "additionalProperties": false, "required": ["plannedSeconds", "rehearsalEvents"], "properties": { "plannedSeconds": { "type": "number", "exclusiveMinimum": 0 }, "autoAdvanceSeconds": { "type": "number", "exclusiveMinimum": 0 }, "rehearsalEvents": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "elapsedSeconds"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "elapsedSeconds": { "type": "number", "minimum": 0 } } } } } },
    "AnimationEntry": { "type": "object", "additionalProperties": false, "required": ["id", "order", "intent", "targetIds", "duration", "easing", "exportState"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "intent": { "enum": ["reveal", "emphasize", "transition"] }, "targetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/definitions/StableId" } }, "duration": { "enum": ["instant", "short", "medium", "long"] }, "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out"] }, "exportState": { "enum": ["animated", "static", "omitted"] } } },
    "Slide": { "type": "object", "additionalProperties": false, "required": ["id", "order", "sectionId", "kind", "layoutId", "slotAssignments", "timing", "animationTimeline"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "sectionId": { "$ref": "common.schema.json#/definitions/StableId" }, "kind": { "enum": ["title", "content", "section", "closing"] }, "layoutId": { "type": "string", "minLength": 1 }, "slotAssignments": { "type": "array", "items": { "$ref": "#/definitions/SlotAssignment" } }, "speakerNotes": { "$ref": "#/definitions/SpeakerNotes" }, "timing": { "$ref": "#/definitions/Timing" }, "animationTimeline": { "type": "array", "items": { "$ref": "#/definitions/AnimationEntry" } } } }
  }
}

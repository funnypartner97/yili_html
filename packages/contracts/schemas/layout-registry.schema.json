{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "layout-registry.schema.json", "title": "LayoutRegistry",
  "type": "object", "additionalProperties": false, "required": ["version", "layouts"],
  "properties": { "version": { "const": "1.0.0" }, "layouts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Layout" } } },
  "definitions": {
    "Layout": { "type": "object", "additionalProperties": false, "required": ["id", "slideKinds", "slots", "safeArea", "exportSupport"], "properties": {
      "id": { "type": "string", "minLength": 1 }, "slideKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["title", "content", "section", "closing"] } },
      "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/LayoutSlot" } },
      "readingOrder": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "safeArea": { "$ref": "common.schema.json#/definitions/Insets" }, "minimumFontSize": { "type": "number", "minimum": 12 },
      "accessibility": { "type": "object", "additionalProperties": false, "required": ["altRequired", "minimumContrast"], "properties": { "altRequired": { "const": true }, "minimumContrast": { "type": "number", "minimum": 4.5 } } },
      "exportSupport": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["html", "pdf", "pptx"] } }
    } },
    "LayoutSlot": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "required", "maxItems"], "properties": {
      "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["text", "media", "table", "metric", "chart"] }, "order": { "type": "integer", "minimum": 0 },
      "required": { "type": "boolean" }, "minItems": { "type": "integer", "minimum": 0 }, "maxItems": { "type": "integer", "minimum": 1 },
      "maxChars": { "type": "integer", "minimum": 1 }, "maxLines": { "type": "integer", "minimum": 1 },
      "aspectRatios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["16:9", "4:3", "1:1", "3:4", "9:16"] } }
    } }
  }
}

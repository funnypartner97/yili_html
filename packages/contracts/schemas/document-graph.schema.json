{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "document-graph.schema.json", "title": "DocumentGraph",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "artifactId", "title", "outputModes", "theme", "assets", "sections"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactId": { "$ref": "common.schema.json#/definitions/StableId" }, "title": { "type": "string", "minLength": 1 },
    "outputModes": { "$ref": "common.schema.json#/definitions/EnabledModes" }, "theme": { "$ref": "common.schema.json#/definitions/Theme" },
    "assets": { "type": "array", "items": { "$ref": "#/definitions/Asset" } },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Section" } }, "presentation": { "$ref": "presentation.schema.json" }
  },
  "definitions": {
    "Asset": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "uri", "mediaIntent"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "kind": { "enum": ["image", "video", "audio"] }, "uri": { "type": "string", "pattern": "^asset:[A-Za-z0-9._/-]+$" }, "mediaIntent": { "$ref": "presentation.schema.json#/definitions/MediaIntent" } } },
    "Section": { "type": "object", "additionalProperties": false, "required": ["id", "order", "title", "blocks"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "title": { "type": "string" }, "blocks": { "type": "array", "items": { "$ref": "#/definitions/Block" } } } },
    "Block": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["id", "order", "kind", "text", "sourceRefs"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "kind": { "const": "richText" }, "text": { "type": "string" }, "sourceRefs": { "$ref": "#/definitions/SourceRefs" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "order", "kind", "table", "sourceRefs"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "kind": { "const": "table" }, "table": { "$ref": "common.schema.json#/definitions/TableData" }, "sourceRefs": { "$ref": "#/definitions/SourceRefs" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "order", "kind", "label", "value", "unit", "sourceRefs"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "kind": { "const": "metric" }, "label": { "type": "string", "minLength": 1 }, "value": { "type": "number" }, "unit": { "type": "string" }, "sourceRefs": { "$ref": "#/definitions/SourceRefs" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "order", "kind", "chart", "frame", "sourceRefs"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "kind": { "const": "chart" }, "chart": { "$ref": "data-visualization.schema.json#/definitions/ChartSpec" }, "frame": { "$ref": "data-visualization.schema.json#/definitions/ChartFrame" }, "sourceRefs": { "$ref": "#/definitions/SourceRefs" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "order", "kind", "assetId", "sourceRefs"], "properties": { "id": { "$ref": "common.schema.json#/definitions/StableId" }, "order": { "type": "integer", "minimum": 0 }, "kind": { "const": "image" }, "assetId": { "$ref": "common.schema.json#/definitions/StableId" }, "sourceRefs": { "$ref": "#/definitions/SourceRefs" } } }
    ] },
    "SourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/definitions/SourceRef" } }
  }
}
